{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runwa",
  "version": "../package.json",
  "identifier": "dev.dmitr.runwa",
  "build": {
    "beforeDevCommand": "npm run tauri:renderer:dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run tauri:renderer:build",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "A cross-platform command palette launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
